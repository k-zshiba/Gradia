{
  "name": "gradia",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/pdf-assets.mjs",
    "prebuild": "node scripts/pdf-assets.mjs",
    "pretest:e2e": "node scripts/pdf-assets.mjs",
    "format:check": "prettier --check src tests *.json *.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package": "tauri build --bundles nsis",
    "package:unsigned": "tauri build --bundles nsis --config src-tauri/tauri.ci.conf.json",
    "release:check": "node scripts/verify-release.mjs",
    "release:version": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "dompurify": "^3.2.0",
    "lucide-react": "^0.468.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-to-markdown": "^2.2.3",
    "monaco-editor": "^0.52.2",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "katex": "^0.18.2"
  }
}
